{
  "name": "obsidian-youtube-transcribe",
  "version": "0.3.0",
  "private": true,
  "description": "Obsidian plugin that transcribes YouTube videos and playlists into vault notes via the local yt-transcribe CLI.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "youtube",
    "transcribe"
  ],
  "author": "Anant Vemuri",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
